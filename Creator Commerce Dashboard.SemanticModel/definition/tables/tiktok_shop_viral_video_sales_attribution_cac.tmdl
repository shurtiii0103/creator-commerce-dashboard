	/// Sort key for Viral Tier.
	column 'Viral Tier Order' = SWITCH ( 'tiktok_shop_viral_video_sales_attribution_cac'[viral_tier], "Normal", 1, "Emerging", 2, "Trending", 3, "Viral", 4, "Mega Viral", 5, 9 )
		dataType: int64
		isHidden
		lineageTag: 7fa1ba05-f4db-4203-8f7e-85c775adf1df
		summarizeBy: none

