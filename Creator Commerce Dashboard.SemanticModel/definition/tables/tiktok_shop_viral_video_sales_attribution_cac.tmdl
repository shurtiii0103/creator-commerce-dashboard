	/// Sort key for Hook Strength Band (1 = 0–20 … 5 = 80–100).
	column 'Hook Band Order' = MIN ( INT ( 'tiktok_shop_viral_video_sales_attribution_cac'[hook_strength_score] / 20 ), 4 ) + 1
		dataType: int64
		isHidden
		lineageTag: 072fb572-533d-4696-85be-4627503161e5
		summarizeBy: none

	/// hook_strength_score bucketed into 20-point bands.
	column 'Hook Strength Band' = SWITCH ( MIN ( INT ( 'tiktok_shop_viral_video_sales_attribution_cac'[hook_strength_score] / 20 ), 4 ), 0, "0–20", 1, "20–40", 2, "40–60", 3, "60–80", "80–100" )
		dataType: string
		lineageTag: 148f2194-caef-4814-b4c5-3659cd483553
		sortByColumn: 'Hook Band Order'

	/// Sort key for Creator Tier (by follower count).
	column 'Creator Tier Order' = SWITCH ( 'tiktok_shop_viral_video_sales_attribution_cac'[creator_tier], "Nano", 1, "Micro", 2, "Mid-Tier", 3, "Macro", 4, "Mega", 5, 9 )
		dataType: int64
		isHidden
		lineageTag: b061ce83-9ba6-433a-933e-76a41ba43a11
		summarizeBy: none

	/// Copy of creator_tier sorted Nano → Mega (copy avoids a sort-by circular dependency).
	column 'Creator Tier' = 'tiktok_shop_viral_video_sales_attribution_cac'[creator_tier]
		dataType: string
		lineageTag: 3ac18690-3c18-47d2-bad0-ccfec2654358
